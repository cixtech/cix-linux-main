From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jianfeng Liu <Jianfeng.Liu@cixtech.com>
Date: Mon, 12 Oct 2026 10:00:00 +0800
Subject: [PATCH 34/92] ASoC: cix: adapt card code to mainline API renames

Adapt the cix card and i2s dai drivers to the mainline ASoC API
renames, guarded with LINUX_VERSION_CODE so the same source builds
across kernel versions:

- struct snd_soc_pcm_runtime: rtd->num renamed to rtd->id (v6.13)
- platform driver remove() callback returns void (v6.11)
- snd_soc_of_parse_daifmt() split into snd_soc_daifmt_parse_format()
  and snd_soc_daifmt_parse_clock_provider_as_phandle() (v6.15)
- SND_SOC_DAIFMT_CBM_CFM/CBS_CFS renamed to CBP_CFP/CBC_CFC (v6.15)
- dai_link dpcm_playback/dpcm_capture renamed to playback_only/
  capture_only (v6.13)

Signed-off-by: Jianfeng Liu <Jianfeng.Liu@cixtech.com>
---
 sound/soc/cix/card-utils.c  | 77 +++++++++++++++++++++++++++++++++++--
 sound/soc/cix/cdns_i2s_mc.c |  7 ++++
 sound/soc/cix/cdns_i2s_sc.c |  7 ++++
 3 files changed, 88 insertions(+), 3 deletions(-)

diff --git a/sound/soc/cix/card-utils.c b/sound/soc/cix/card-utils.c
index f208159e8..2f202e3e9 100644
--- a/sound/soc/cix/card-utils.c
+++ b/sound/soc/cix/card-utils.c
@@ -4,6 +4,7 @@
 #include <linux/module.h>
 #include <linux/mfd/syscon.h>
 #include <linux/regmap.h>
+#include <linux/version.h>
 #include "card-utils.h"
 #include <sound/jack.h>
 
@@ -24,7 +25,11 @@ static int cix_jack_init(struct snd_soc_pcm_runtime *rtd)
 	struct snd_soc_dai *codec_dai = snd_soc_rtd_to_codec(rtd, 0);
 	struct cix_asoc_card *priv = snd_soc_card_get_drvdata(rtd->card);
 	struct dai_link_info *link_info =
+#if KERNEL_VERSION(6, 13, 0) > LINUX_VERSION_CODE
 		(struct dai_link_info *)((priv->link_info + rtd->num));
+#else
+		(struct dai_link_info *)((priv->link_info + rtd->id));
+#endif
 	struct device *dev = rtd->card->dev;
 	int ret, jack[JACK_CNT], cnt, i;
 
@@ -73,18 +78,23 @@ static int cix_dailink_parsing_fmt(struct device_node *np,
 	struct device_node *framemaster = NULL;
 	unsigned int dai_fmt;
 
-	dai_fmt = snd_soc_of_parse_daifmt(np, NULL,
-				&bitclkmaster, &framemaster);
+	dai_fmt = snd_soc_daifmt_parse_format(np, NULL);
+	snd_soc_daifmt_parse_clock_provider_as_phandle(np, NULL, &bitclkmaster, &framemaster);
 	if (bitclkmaster != framemaster) {
 		pr_info("Must be the same bitclock and frame master\n");
 		return -EINVAL;
 	}
 	if (bitclkmaster) {
-		dai_fmt &= ~SND_SOC_DAIFMT_MASTER_MASK;
 		if (codec_np == bitclkmaster)
+#if KERNEL_VERSION(6, 15, 0) > LINUX_VERSION_CODE
 			dai_fmt |= SND_SOC_DAIFMT_CBM_CFM;
 		else
 			dai_fmt |= SND_SOC_DAIFMT_CBS_CFS;
+#else
+			dai_fmt |= SND_SOC_DAIFMT_CBP_CFP;
+		else
+			dai_fmt |= SND_SOC_DAIFMT_CBC_CFC;
+#endif
 	}
 	of_node_put(bitclkmaster);
 	of_node_put(framemaster);
@@ -118,7 +128,11 @@ static int dai_set_sysclk(struct snd_pcm_substream *substream,
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
 	struct cix_asoc_card *priv = snd_soc_card_get_drvdata(rtd->card);
 	struct dai_link_info *link_info =
+#if KERNEL_VERSION(6, 13, 0) > LINUX_VERSION_CODE
 		(struct dai_link_info *)((priv->link_info + rtd->num));
+#else
+		(struct dai_link_info *)((priv->link_info + rtd->id));
+#endif
 	struct snd_soc_dai *codec_dai;
 	unsigned int mclk, mclk_div, mclk_parent_rate, sample_rate;
 	struct clk *mclk_parent;
@@ -218,7 +232,11 @@ static int dai_startup(struct snd_pcm_substream *substream)
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
 	struct cix_asoc_card *priv = snd_soc_card_get_drvdata(rtd->card);
 	struct dai_link_info *link_info =
+#if KERNEL_VERSION(6, 13, 0) > LINUX_VERSION_CODE
 		(struct dai_link_info *)((priv->link_info + rtd->num));
+#else
+		(struct dai_link_info *)((priv->link_info + rtd->id));
+#endif
 	int ret;
 
 	if (link_info->mclk_fs) {
@@ -239,7 +257,11 @@ static void dai_shutdown(struct snd_pcm_substream *substream)
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
 	struct cix_asoc_card *priv = snd_soc_card_get_drvdata(rtd->card);
 	struct dai_link_info *link_info =
+#if KERNEL_VERSION(6, 13, 0) > LINUX_VERSION_CODE
 		(struct dai_link_info *)((priv->link_info + rtd->num));
+#else
+		(struct dai_link_info *)((priv->link_info + rtd->id));
+#endif
 
 	if (link_info->mclk_fs) {
 		link_info->mclk_enabled = false;
@@ -254,7 +276,11 @@ static int dai_hw_params(struct snd_pcm_substream *substream,
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
 	struct cix_asoc_card *priv = snd_soc_card_get_drvdata(rtd->card);
 	struct dai_link_info *link_info =
+#if KERNEL_VERSION(6, 13, 0) > LINUX_VERSION_CODE
 		(struct dai_link_info *)((priv->link_info + rtd->num));
+#else
+		(struct dai_link_info *)((priv->link_info + rtd->id));
+#endif
 
 	if (link_info->mclk_fs)
 		return dai_set_sysclk(substream, params, link_info->mclk_fs);
@@ -274,9 +300,17 @@ static int cix_dailink_init(struct snd_soc_pcm_runtime *rtd)
 	struct device *dev = rtd->card->dev;
 	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 	struct dai_link_info *link_info =
+#if KERNEL_VERSION(6, 13, 0) > LINUX_VERSION_CODE
 		(struct dai_link_info *)((priv->link_info + rtd->num));
+#else
+		(struct dai_link_info *)((priv->link_info + rtd->id));
+#endif
 	struct snd_soc_dai_link *dai_link =
+#if KERNEL_VERSION(6, 13, 0) > LINUX_VERSION_CODE
 		(struct snd_soc_dai_link *)((priv)->card->dai_link + rtd->num);
+#else
+		(struct snd_soc_dai_link *)((priv)->card->dai_link + rtd->id);
+#endif
 	int ret, fmt;
 
 	dev_dbg(dev, "%s, dai_fmt:0x%x\n", __func__, dai_link->dai_fmt);
@@ -347,7 +381,11 @@ static int cix_card_suspend_post(struct snd_soc_card *card)
 	struct dai_link_info *link_info;
 
 	for_each_card_rtds(card, rtd) {
+#if KERNEL_VERSION(6, 13, 0) > LINUX_VERSION_CODE
 		link_info = (struct dai_link_info *)((priv->link_info + rtd->num));
+#else
+		link_info = (struct dai_link_info *)((priv->link_info + rtd->id));
+#endif
 
 		if (link_info->mclk_enabled)
 			clk_disable_unprepare(link_info->clk_mclk);
@@ -364,7 +402,11 @@ static int cix_card_resume_pre(struct snd_soc_card *card)
 	int ret;
 
 	for_each_card_rtds(card, rtd) {
+#if KERNEL_VERSION(6, 13, 0) > LINUX_VERSION_CODE
 		link_info = (struct dai_link_info *)((priv->link_info + rtd->num));
+#else
+		link_info = (struct dai_link_info *)((priv->link_info + rtd->id));
+#endif
 
 		if (link_info->mclk_enabled) {
 			ret = clk_prepare_enable(link_info->clk_mclk);
@@ -665,8 +707,13 @@ static struct snd_soc_dai_link sky1_dailink[] = {
 				| SND_SOC_DAIFMT_GATED
 				| SND_SOC_DAIFMT_CBC_CFC,
 		.init = &cix_dailink_init,
+#if KERNEL_VERSION(6, 13, 0) > LINUX_VERSION_CODE
 		.dpcm_playback = 1,
 		.dpcm_capture = 1,
+#else
+		.playback_only = 1,
+		.capture_only = 1,
+#endif
 		.ops = &cix_dailink_ops,
 		SND_SOC_DAILINK_REG(cix_i2s0_sc_alc5682),
 	},
@@ -678,7 +725,11 @@ static struct snd_soc_dai_link sky1_dailink[] = {
 				| SND_SOC_DAIFMT_GATED
 				| SND_SOC_DAIFMT_CBC_CFC,
 		.init = &cix_dailink_init,
+#if KERNEL_VERSION(6, 13, 0) > LINUX_VERSION_CODE
 		.dpcm_playback = 1,
+#else
+		.playback_only = 1,
+#endif
 		.ops = &cix_dailink_ops,
 		SND_SOC_DAILINK_REG(cix_i2s3_mc_alc1019),
 	},
@@ -690,7 +741,11 @@ static struct snd_soc_dai_link sky1_dailink[] = {
 				| SND_SOC_DAIFMT_GATED
 				| SND_SOC_DAIFMT_CBC_CFC,
 		.init = &cix_dailink_init,
+#if KERNEL_VERSION(6, 13, 0) > LINUX_VERSION_CODE
 		.dpcm_playback = 1,
+#else
+		.playback_only = 1,
+#endif
 		.ops = &cix_dailink_ops,
 		SND_SOC_DAILINK_REG(cix_i2s5_dp0),
 	},
@@ -702,7 +757,11 @@ static struct snd_soc_dai_link sky1_dailink[] = {
 				| SND_SOC_DAIFMT_GATED
 				| SND_SOC_DAIFMT_CBC_CFC,
 		.init = &cix_dailink_init,
+#if KERNEL_VERSION(6, 13, 0) > LINUX_VERSION_CODE
 		.dpcm_playback = 1,
+#else
+		.playback_only = 1,
+#endif
 		.ops = &cix_dailink_ops,
 		SND_SOC_DAILINK_REG(cix_i2s6_dp1),
 	},
@@ -714,7 +773,11 @@ static struct snd_soc_dai_link sky1_dailink[] = {
 				| SND_SOC_DAIFMT_GATED
 				| SND_SOC_DAIFMT_CBC_CFC,
 		.init = &cix_dailink_init,
+#if KERNEL_VERSION(6, 13, 0) > LINUX_VERSION_CODE
 		.dpcm_playback = 1,
+#else
+		.playback_only = 1,
+#endif
 		.ops = &cix_dailink_ops,
 		SND_SOC_DAILINK_REG(cix_i2s7_dp2),
 	},
@@ -726,7 +789,11 @@ static struct snd_soc_dai_link sky1_dailink[] = {
 				| SND_SOC_DAIFMT_GATED
 				| SND_SOC_DAIFMT_CBC_CFC,
 		.init = &cix_dailink_init,
+#if KERNEL_VERSION(6, 13, 0) > LINUX_VERSION_CODE
 		.dpcm_playback = 1,
+#else
+		.playback_only = 1,
+#endif
 		.ops = &cix_dailink_ops,
 		SND_SOC_DAILINK_REG(cix_i2s8_dp3),
 	},
@@ -738,7 +805,11 @@ static struct snd_soc_dai_link sky1_dailink[] = {
 				| SND_SOC_DAIFMT_GATED
 				| SND_SOC_DAIFMT_CBC_CFC,
 		.init = &cix_dailink_init,
+#if KERNEL_VERSION(6, 13, 0) > LINUX_VERSION_CODE
 		.dpcm_playback = 1,
+#else
+		.playback_only = 1,
+#endif
 		.ops = &cix_dailink_ops,
 		SND_SOC_DAILINK_REG(cix_i2s9_dp4),
 	},
diff --git a/sound/soc/cix/cdns_i2s_mc.c b/sound/soc/cix/cdns_i2s_mc.c
index 86c2dd86b..cbd8b26a4 100644
--- a/sound/soc/cix/cdns_i2s_mc.c
+++ b/sound/soc/cix/cdns_i2s_mc.c
@@ -11,6 +11,7 @@
 #include <linux/mfd/syscon.h>
 #include <linux/regmap.h>
 #include <linux/reset.h>
+#include <linux/version.h>
 #include <sound/dmaengine_pcm.h>
 #include <sound/pcm_params.h>
 
@@ -1086,13 +1087,19 @@ static int cdns_i2s_mc_probe(struct platform_device *pdev)
 	return 0;
 }
 
+#if KERNEL_VERSION(6, 11, 0) > LINUX_VERSION_CODE
 static int cdns_i2s_mc_remove(struct platform_device *pdev)
+#else
+static void cdns_i2s_mc_remove(struct platform_device *pdev)
+#endif
 {
 	if (!pm_runtime_status_suspended(&pdev->dev))
 		pm_runtime_force_suspend(&pdev->dev);
 	pm_runtime_disable(&pdev->dev);
 
+#if KERNEL_VERSION(6, 11, 0) > LINUX_VERSION_CODE
 	return 0;
+#endif
 }
 
 static int __maybe_unused cdns_i2s_mc_runtime_suspend(struct device *dev)
diff --git a/sound/soc/cix/cdns_i2s_sc.c b/sound/soc/cix/cdns_i2s_sc.c
index 49b5bcc09..c557d60c3 100644
--- a/sound/soc/cix/cdns_i2s_sc.c
+++ b/sound/soc/cix/cdns_i2s_sc.c
@@ -12,6 +12,7 @@
 #include <linux/regmap.h>
 #include <linux/reset.h>
 #include <linux/spinlock.h>
+#include <linux/version.h>
 #include <sound/dmaengine_pcm.h>
 #include <sound/pcm_params.h>
 #include <sound/soc.h>
@@ -1196,13 +1197,19 @@ static int cdns_i2s_sc_probe(struct platform_device *pdev)
 	return 0;
 }
 
+#if KERNEL_VERSION(6, 11, 0) > LINUX_VERSION_CODE
 static int cdns_i2s_sc_remove(struct platform_device *pdev)
+#else
+static void cdns_i2s_sc_remove(struct platform_device *pdev)
+#endif
 {
 	if (!pm_runtime_status_suspended(&pdev->dev))
 		pm_runtime_force_suspend(&pdev->dev);
 	pm_runtime_disable(&pdev->dev);
 
+#if KERNEL_VERSION(6, 11, 0) > LINUX_VERSION_CODE
 	return 0;
+#endif
 }
 
 static int __maybe_unused cdns_i2s_sc_runtime_suspend(struct device *dev)
